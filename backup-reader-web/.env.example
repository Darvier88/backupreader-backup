# Variables que usa la app. Los valores van en Vercel (Settings → Environment
# Variables), NUNCA en este repositorio: es público.

# Firebase (web). Públicas por diseño; restringir la clave en Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Selector de Google Drive. Públicas por diseño; restringir en Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_KEYP=      # clave publicable (pk_...)
STRIPE_SECRET_KEY=            # clave secreta (sk_...). SOLO servidor; NUNCA con NEXT_PUBLIC_

# Firebase Admin (servidor). Una de estas tres formas:
FIREBASE_SERVICE_ACCOUNT_B64= # el JSON de la cuenta de servicio en base64 (recomendada)
FIREBASE_SERVICE_ACCOUNT=     # o el JSON tal cual
# ...o estas tres
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Correo (opcional)
RESEND_API_KEY=
CORREO_REMITENTE=
CORREO_API_URL=

# Otras
NEXT_PUBLIC_URL_BASE=
# Prueba gratuita de 15 dias. APAGADA si falta: "true" o "1" para encenderla.
NEXT_PUBLIC_FREE_TRIAL_ENABLED=
# Analisis de chats (fase 1, sin IA). Apagado si falta. "1" para encenderlo.
NEXT_PUBLIC_ANALISIS_ENABLED=
# Respaldos de Instagram. Apagado si falta. "1" para encenderlo.
NEXT_PUBLIC_INSTAGRAM_ENABLED=

# Base de Firestore con nombre, para el entorno de pruebas dentro del mismo
# proyecto. Vacio = la base por defecto, que es la de produccion.
NEXT_PUBLIC_FIRESTORE_DB=
