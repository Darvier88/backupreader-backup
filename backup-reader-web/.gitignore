# configuración de extensiones: `firebase ext:export` escribe
# las claves de API en claro dentro de estos .env
extensions/

# secretos: ampliamos lo que ya había (.env*.local no cubre
# un .env a secas, que es justo donde acaban las claves)
.env
.env.*
!.env.example
_env.txt
# Credenciales de Google (OAuth, cuentas de servicio). Estuvieron subidas
# y el repo es público: nunca más en git, solo en Vercel.
config/secret-google*.json
*service-account*.json
*-firebase-adminsdk-*.json
*.pem
*.p12
# Caché incremental de tsc. La genera `tsc --noEmit` al comprobar tipos y no
# aporta nada al repositorio.
tsconfig.tsbuildinfo
.env.local
